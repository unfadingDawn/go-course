{
  "openapi": "3.0.3",
  "info": {"title": "Movie API", "version": "1.0.0"},
  "paths": {
    "/load-movies": {
      "get": {
        "summary": "Load movies in an inclusive ID range",
        "description": "Requires 1 <= from <= to. Full success returns an array. Individual failures do not stop the range: 502 returns movies and errors, or 504 if any individual request timed out. These objects also cover all-items-failed cases. Cancellation or expiration of the entire operation stops processing; an operation timeout returns a plain-text 504 without partial results.",
        "parameters": [
          {"name": "from", "in": "query", "required": true, "schema": {"type": "integer", "minimum": 1}},
          {"name": "to", "in": "query", "required": true, "schema": {"type": "integer", "minimum": 1}}
        ],
        "responses": {
          "200": {"description": "Loaded movies", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/Movie"}}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "502": {"description": "One or more movies failed to load", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LoadMoviesResult"}}}},
          "504": {"description": "Individual upstream timeout (JSON result), or entire operation timeout (plain text)", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LoadMoviesResult"}}, "text/plain": {"schema": {"type": "string"}}}}
        }
      }
    },
    "/last-movie": {
      "get": {
        "summary": "Find the last available movie",
        "responses": {
          "200": {"description": "Last movie", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Movie"}}}},
          "404": {"description": "No movies found", "content": {"text/plain": {"schema": {"type": "string"}}}},
          "502": {"$ref": "#/components/responses/BadGateway"},
          "504": {"$ref": "#/components/responses/GatewayTimeout"}
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LoadMoviesResult": {
        "type": "object",
        "required": ["movies", "errors"],
        "properties": {
          "movies": {"type": "array", "items": {"$ref": "#/components/schemas/Movie"}},
          "errors": {"type": "array", "items": {"$ref": "#/components/schemas/MovieLoadError"}}
        }
      },
      "MovieLoadError": {
        "type": "object",
        "required": ["id", "code", "message"],
        "properties": {
          "id": {"type": "integer", "format": "int64"},
          "code": {"type": "string", "enum": ["unavailable", "deadline_exceeded"]},
          "message": {"type": "string"}
        }
      },
      "Movie": {
        "type": "object",
        "required": ["id", "title", "year", "director"],
        "properties": {
          "id": {"type": "integer", "format": "int64"},
          "title": {"type": "string"},
          "year": {"type": "integer"},
          "director": {"type": "string"}
        }
      }
    },
    "responses": {
      "BadRequest": {"description": "Invalid range parameters", "content": {"text/plain": {"schema": {"type": "string"}}}},
      "BadGateway": {"description": "Movie service request failed", "content": {"text/plain": {"schema": {"type": "string"}}}},
      "GatewayTimeout": {"description": "Movie service timed out", "content": {"text/plain": {"schema": {"type": "string"}}}}
    }
  }
}
